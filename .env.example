# =====================================================================
# CẤU HÌNH BIẾN MÔI TRƯỜNG
#
# Tệp này chỉ còn CẤU HÌNH TRIỂN KHAI: khoá API, chọn mô hình, chọn miền,
# đường dẫn lưu trữ. Không còn tham số nào điều chỉnh chất lượng truy xuất.
#
# 15 biến đã được gỡ bỏ trong đợt refactor tổng quát hoá kiến trúc:
#
#   HYBRID_RELEVANCE_FLOOR, SEMANTIC_FLOOR, RRF_K, RRF_WEIGHT_DENSE,
#   RRF_WEIGHT_SPARSE, RERANK_MARGIN, ENABLE_RERANK
#       -> Đều là hằng số quét siêu tham số trên đúng corpus này với đúng
#          embedding model này. Thay bằng RRF chuẩn (không trọng số) và cơ
#          chế chọn theo phân bố điểm của chính lượt truy vấn.
#          Xem src/retrieval/fusion.py và src/retrieval/scope.py.
#
#   SEMANTIC_CACHE_THRESHOLD, CACHE_TTL_DAYS
#       -> Là quyết định RỦI RO của từng miền, chuyển vào `policy` trong
#          domains/<id>/domain.yaml.
#
#   ROUTER_LLM_MODEL, RERANK_LLM_MODEL, HISTORY_TOKEN_BUDGET,
#   CONTEXT_TOKEN_BUDGET
#       -> Thuộc các node đã bị gỡ bỏ (router LLM, rerank, memory, compact).
#
#   TEMPERATURE, MAX_TOKENS
#       -> Chưa từng được mã nguồn đọc. MODEL_ROLES trong src/llm/provider.py
#          đặt giá trị riêng cho từng vai trò.
# =====================================================================

# --- 1. OPENROUTER & LLM (BẮT BUỘC) ---
# Khoá API OpenRouter để gọi mô hình ngôn ngữ và mô hình nhúng
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tuỳ chọn endpoint (mặc định: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Mô hình chạy vòng lặp Agentic ReAct.
# BẮT BUỘC hỗ trợ Function Calling / Native Tool Use.
LLM_MODEL=deepseek/deepseek-v4-flash

# Mô hình dự phòng khi mô hình chính lỗi, timeout hoặc rate limit
FALLBACK_LLM_MODEL=openai/gpt-oss-20b

# Mô hình nhúng cho chỉ mục ngữ nghĩa.
# Đổi model thì phải chạy lại:
#   python scripts/ingest/build_semantic_index.py
#   python scripts/ingest/calibrate_scope.py --labels data/benchmark/qa_testset_v2.json
EMBEDDING_MODEL=google/gemini-embedding-2

# --- 2. MIỀN HOẠT ĐỘNG ---
# Domain Pack quyết định kho tài liệu, persona, bộ công cụ, từ điển và quy tắc
# kiểm chứng. Giá trị là tên thư mục trong domains/.
# Tạo miền mới: chép domains/vietnam_traffic/ rồi thay nội dung — không sửa code.
ACTIVE_DOMAIN=vietnam_traffic

# --- 3. CACHE & LƯU TRỮ ---
# Bật/tắt Semantic Cache cho câu trả lời đã qua kiểm chứng (true/false).
# Ngưỡng và thời hạn cache nằm trong `policy` của Domain Pack.
ENABLE_SEMANTIC_CACHE=true

# Để trống để dùng mặc định trong data/runtime/
ANSWER_CACHE_DB_PATH=
CHECKPOINT_DB_PATH=

# --- 4. QUAN TRẮC ---
TRACE_DIR=data/runtime/traces
TRACE_RETENTION_DAYS=14

# Tuỳ chọn: LangSmith Cloud (mặc định tắt; trace cục bộ luôn chạy)
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=lextraffic-ai
