# =====================================================================
# LEXTRAFFIC AI - CẤU HÌNH BIẾN MÔI TRƯỜNG (.env.example)
# Kiến trúc: Agentic ReAct StateGraph trên LangGraph 1.x
# Hỗ trợ 6 văn bản pháp luật giao thông & Nghị định xử phạt 168/2024
# =====================================================================

# --- 1. OPENROUTER & LLM CHÍNH (BẮT BUỘC) ---
# Khóa API OpenRouter để gọi các mô hình LLM và Embedding
OPENROUTER_API_KEY=your_openrouter_api_key_here

# Tùy chọn URL endpoint OpenRouter (mặc định: https://openrouter.ai/api/v1)
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Mô hình Ngôn ngữ Lớn (LLM) chạy vòng lặp Agentic ReAct.
# BẮT BUỘC phải là mô hình hỗ trợ Function Calling / Native Tool Use.
# Khuyến nghị: deepseek/deepseek-v4-flash, google/gemini-2.5-flash
LLM_MODEL=deepseek/deepseek-v4-flash

# Mô hình dự phòng tự động khi model chính gặp lỗi, timeout hoặc rate limit
FALLBACK_LLM_MODEL=openai/gpt-oss-20b

# --- 2. THAM SỐ SINH VĂN BẢN (GENERATION) ---
# Nhiệt độ sinh câu trả lời (0.0: chính xác tuyệt đối theo căn cứ pháp luật, tránh bịa đặt)
TEMPERATURE=0.0

# Giới hạn số token tối đa cho câu trả lời sinh ra
MAX_TOKENS=1000

# --- 3. VECTOR EMBEDDING & TRUY XUẤT LAI (HYBRID SEARCH) ---
# Mô hình Vector Embedding cho chỉ mục ngữ nghĩa hợp nhất (3072 chiều)
# Lưu ý: Nếu đổi model khác số chiều, cần chạy lại: python scripts/build_semantic_index.py
EMBEDDING_MODEL=google/gemini-embedding-2

# Ngưỡng sàn độ tương đồng ngữ nghĩa (thang 0-100; dưới ngưỡng này bị loại bỏ)
HYBRID_RELEVANCE_FLOOR=60.0

# Tham số Reciprocal Rank Fusion (RRF) kết hợp Dense Vector + BM25
RRF_K=30
RRF_WEIGHT_DENSE=0.6
RRF_WEIGHT_SPARSE=0.4

# --- 4. BỘ NHỚ VÀ CACHE NGỮ NGHĨA (SEMANTIC CACHE & MEMORY) ---
# Bật/tắt Semantic Cache cho các câu trả lời đã qua kiểm chứng (true/false)
ENABLE_SEMANTIC_CACHE=true

# Ngưỡng cosine tối thiểu để coi là trúng Semantic Cache (0.97: chặn nhầm lẫn đối tượng)
SEMANTIC_CACHE_THRESHOLD=0.97

# Thời hạn sống của bản ghi cache (ngày)
CACHE_TTL_DAYS=30

# Đường dẫn tệp SQLite lưu Answer Cache (để trống dùng data/runtime/answer_cache.sqlite)
ANSWER_CACHE_DB_PATH=

# Đường dẫn tệp SQLite lưu checkpoint hội thoại đa lượt (để trống dùng data/runtime/checkpoints.sqlite)
CHECKPOINT_DB_PATH=

# Ngân sách token cho phần lịch sử hội thoại gửi lên Agent
HISTORY_TOKEN_BUDGET=2000

# --- 5. QUAN TRẮC & GIÁM SÁT (OBSERVABILITY) ---
# Thư mục lưu trữ trace JSONL quan trắc cục bộ
TRACE_DIR=data/runtime/traces

# Số ngày lưu trữ file trace trước khi tự động dọn dẹp
TRACE_RETENTION_DAYS=14

# Tùy chọn: Giám sát LangSmith Cloud (mặc định: false)
LANGSMITH_TRACING=false
# LANGSMITH_API_KEY=your_langsmith_api_key_here
# LANGSMITH_PROJECT=lextraffic-ai
